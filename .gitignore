# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the documented, secret-free template — this one must be
# tracked so every required var is discoverable (lib/config/env.ts).
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# development-only official EOF/Ministry of Health medication datasets —
# see data/README.md. Never committed: production redistribution/licensing
# is not yet resolved (medication-resolution-architecture.md §12 item 7).
# Only data/README.md and data/fixtures/ (small, hand-curated) are tracked.
/data/raw/**
/data/normalized/**

# service worker — build output (@serwist/next), regenerated on every
# `next build` from app/sw.ts; never hand-edited, never committed.
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js
/public/swe-worker-*.js.map
