# Copy to .env.local for development. NEVER commit a file with real
# secret values — .env* is already gitignored (see .gitignore).
#
# See lib/config/env.ts for the validated schema every one of these is
# checked against at first use (fails fast with a clear error if missing
# or malformed — never silently propagates `undefined`).

NODE_ENV=development

# --- Database (Neon Postgres, ADR-002) ---------------------------------
# Pooled (PgBouncer transaction-mode) connection — used for ALL
# request-time application traffic via lib/db/client.ts + lib/db/rls.ts.
# Local dev: point this at a throwaway/dev Postgres (Neon free tier or a
# local Docker Postgres both work for `pnpm dev`); production uses the
# real Neon project's `-pooler` hostname.
DATABASE_URL=postgres://user:password@localhost:5432/medtracking

# DIRECT (non-pooled) connection — used ONLY by migration tooling
# (`pnpm db:generate`, `pnpm db:migrate`, `pnpm db:seed`) and other
# admin/one-off scripts, never by request-time code. On Neon this is the
# non-"-pooler" hostname.
DATABASE_URL_DIRECT=postgres://user:password@localhost:5432/medtracking

# Local-dev-only database driver override. `getDb()` (lib/db/client.ts)
# normally uses Neon's HTTP proxy driver, which can ONLY reach a real Neon
# endpoint — it cannot talk to a local/throwaway Postgres over plain TCP.
# Set this to `local-pg` to make `pnpm dev` use a standard `pg`
# (node-postgres) connection instead, so DATABASE_URL can genuinely point
# at a local Docker Postgres as documented above. Deliberately inert
# unless NODE_ENV is also NOT "production" (see shouldUseLocalPgDriver()
# in lib/db/client.ts) — never set this in a real deployment.
# DATABASE_DRIVER=local-pg

# --- Better Auth (ADR-003) ----------------------------------------------
# High-entropy random secret (>= 32 chars), e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-with-a-real-32-plus-character-random-secret
# The app's own public base URL.
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated list of origins Better Auth trusts for CSRF/origin
# checks (ADR-003 §"CSRF posture") — lock this to the production
# domain(s) only in production config, never a permissive/dev default.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# HMAC pepper used to derive account_session.ip_hash = HMAC-SHA256(ip, pepper)
# (ADR-003 "Additional findings" — never a bare/unsalted hash of an IP).
# High-entropy random secret (>= 32 chars), distinct from BETTER_AUTH_SECRET.
IP_HASH_PEPPER=replace-with-a-different-32-plus-character-random-secret

# --- Google Sign-In (ADR-003 addendum, 2026-08-21) ---------------------
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0
# Client ID (Web application type). See ADR-003 addendum A.8 for setup.
GOOGLE_CLIENT_ID=replace-with-real-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-real-client-secret

# --- Account deletion (CLAUDE.md rule 9, Phase 2 §4) --------------------
# HMAC pepper for deleted_profile_registry/account_deletion_audit's
# account_id_hash = HMAC-SHA256(accountId, pepper). Dedicated key, not
# reused from IP_HASH_PEPPER. High-entropy random secret (>= 32 chars).
ACCOUNT_ID_HASH_PEPPER=replace-with-a-different-32-plus-character-random-secret

# --- Vercel Blob (user-uploaded medication photos) ----------------------
# Powers `POST/GET/DELETE /api/medications/[id]/photo`
# (lib/medications/server/photo.ts). NOT required for the rest of the app
# to build/run/typecheck/test — left unset, only the photo feature itself
# fails (with a clear error) the moment it's actually used.
#
# Setup (one-time, on your Vercel project dashboard, same pattern as the
# Google OAuth credentials above): Vercel dashboard → your project →
# Storage tab → Create Database → Blob → create a store → an
# environment variable named BLOB_READ_WRITE_TOKEN is added to your
# Vercel project automatically (pull it into `.env.local` with
# `vercel env pull` for local dev, or copy the value shown in the
# dashboard). There is no meaningful local-only fallback for blob storage
# (unlike DATABASE_URL's `local-pg` escape hatch) — to actually test
# uploads locally you need a real token pointing at a real (can be a
# throwaway/dev) Blob store; without it, `pnpm dev` still runs fine, but
# any request to the photo endpoints returns a clear "not configured"
# error instead of a blob write.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Database integration tests (stabilization task, 2026-08-29) --------
# `pnpm test:db` runs the *.integration.test.ts files against a REAL
# Postgres instance — normally skipped (describe.skipIf(!connectionString))
# because this is unset by default; this was the exact gap that let a real
# migration-drift bug (migration 0011 never applied to Production) go
# undetected for as long as it did. NEVER point these at Production or at
# the same DATABASE_URL_DIRECT above — use a disposable, isolated Postgres:
#
#   docker run --rm -d --name medtrack-test-pg -p 55432:5432 \
#     -e POSTGRES_PASSWORD=test -e POSTGRES_DB=medtrack_test postgres:16
#   DATABASE_URL_DIRECT=postgres://postgres:test@localhost:55432/medtrack_test pnpm db:migrate
#   pnpm test:db
#
# SYNC_IT_DATABASE_URL / OAUTH_IT_DATABASE_URL: the app-traffic connection
# string most integration tests use directly.
SYNC_IT_DATABASE_URL=postgres://postgres:test@localhost:55432/medtrack_test
OAUTH_IT_DATABASE_URL=postgres://postgres:test@localhost:55432/medtrack_test
# SYNC_IT_ADMIN_DATABASE_URL: a separate table-owning/superuser connection
# some sync tests use to seed RLS-protected fixture rows a normal app-role
# connection couldn't write directly (mirrors production's app-role split,
# ADR-002/Phase 4) — same instance as above is fine for local/CI use where
# a single `postgres` superuser role serves both purposes.
# SYNC_IT_ADMIN_DATABASE_URL=postgres://postgres:test@localhost:55432/medtrack_test

# --- Logging (optional) --------------------------------------------------
# One of: debug | info | warn | error. Defaults to "debug" in development,
# "info" in production if unset.
# LOG_LEVEL=debug
